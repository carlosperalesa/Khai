# ╔═══════════════════════════════════════════════════════════════╗
# ║  SECRETS TEMPLATE                                             ║
# ║  Copiar este archivo a: .env                                 ║
# ║  Llenar con tus credenciales                                 ║
# ║  NUNCA commitar .env a Git                                   ║
# ╚═══════════════════════════════════════════════════════════════╝

# ===== GOOGLE CLOUD =====
# Obtener en: https://console.cloud.google.com
GOOGLE_CLOUD_PROJECT_ID=tu_google_cloud_project_id_aqui
GOOGLE_PROJECT_NAME=tu_google_project_name_aqui
GOOGLE_CLIENT_SECRET_JSON=tu_google_client_secret_json_aqui
GOOGLE_OAUTH_TOKEN_JSON=tu_google_oauth_token_json_aqui

# ===== GEMINI API =====
# Obtener en: https://ai.google.dev
# Click en "Get API Key" (no requiere verificación)
GEMINI_API_KEY=tu_gemini_api_key_aqui
# GEMINI_API_KEY_FALLBACK=tu_gemini_fallback_aqui
# ===== YOUTUBE DATA API =====
# Obtener en: https://console.cloud.google.com
# APIs & Services → Credentials → Create Credentials → API Key
YOUTUBE_API_KEY=tu_youtube_api_key_aqui

# ===== PEXELS API =====
# Obtener en: https://www.pexels.com/api/
# Dashboard → Create New App → Copy API Key
# Dejar en blanco si aún no tienes
PEXELS_API_KEY=tu_pexels_api_key_aqui

# ===== TELEGRAM BOT =====
# Crear bot: @BotFather en Telegram
# /newbot → Responder preguntas → Copiar token
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token_aqui

# Obtener tu User ID: @userinfobot en Telegram
# /start → Te devuelve tu ID
TELEGRAM_USER_ID=tu_telegram_user_id_aqui

# Típicamente igual a USER_ID si es 1-to-1
TELEGRAM_CHAT_ID=tu_telegram_chat_id_aqui

# ===== CONFIGURACIÓN DEL SISTEMA =====
# Zona horaria
DROPLET_TIMEZONE=tu_droplet_timezone_aqui

# IP del Droplet (para referencias)
DROPLET_IP=tu_droplet_ip_aqui

# Idioma de contenido
CONTENT_LANGUAGE=tu_content_language_aqui

# Nichos separados por coma
CONTENT_NICHES=tu_content_niches_aqui

# ===== LOGGING =====
LOG_LEVEL=tu_log_level_aqui
DEBUG_MODE=tu_debug_mode_aqui

# ===== RUTAS (típicamente no cambiar) =====
DATABASE_PATH=tu_database_path_aqui
VIDEOS_PATH=tu_videos_path_aqui
SCRIPTS_PATH=tu_scripts_path_aqui
AUDIO_PATH=tu_audio_path_aqui
RENDERED_PATH=tu_rendered_path_aqui
LOGS_PATH=tu_logs_path_aqui
THUMBNAILS_PATH=tu_thumbnails_path_aqui
CACHE_PATH=tu_cache_path_aqui

# ===== OPCIONES AVANZADAS =====
# FFmpeg encoding quality (18-28, menor = mejor)
FFMPEG_CRF=tu_ffmpeg_crf_aqui

# FFmpeg preset (ultrafast, fast, medium, slow, veryslow)
FFMPEG_PRESET=tu_ffmpeg_preset_aqui

# Bitrate en kbps
VIDEO_BITRATE=tu_video_bitrate_aqui

# FPS del video
VIDEO_FPS=tu_video_fps_aqui

# Resolución (720p, 1080p, 2160p)
VIDEO_RESOLUTION=tu_video_resolution_aqui

# Voice para TTS (ver AGENTS.md para opciones)
TTS_VOICE=tu_tts_voice_aqui

# Duración target en minutos
VIDEO_DURATION_MINUTES=tu_video_duration_minutes_aqui

# Horario default de publicación (24h format CLT)
PUBLISH_TIME=tu_publish_time_aqui

# ===== LIMITES DE APIS (típicamente no cambiar) =====
PEXELS_RATE_LIMIT=tu_pexels_rate_limit_aqui
YOUTUBE_QUOTA_LIMIT=tu_youtube_quota_limit_aqui
GEMINI_MAX_TOKENS=tu_gemini_max_tokens_aqui

# ===== DESARROLLO (opcional) =====
# Modo de test (no sube realmente a YouTube)
TEST_MODE=tu_test_mode_aqui

# Simular demoras para testing
SIMULATE_DELAYS=tu_simulate_delays_aqui

# ╔═══════════════════════════════════════════════════════════════╗
# ║  INSTRUCCIONES DE LLENADO                                     ║
# ║                                                                ║
# ║  1. Copiar este archivo:                                      ║
# ║     cp secrets.env.template .env                             ║
# ║                                                                ║
# ║  2. Llenar cada variable según las instrucciones en API_SETUP  ║
# ║                                                                ║
# ║  3. Cambiar permisos:                                          ║
# ║     chmod 600 .env                                            ║
# ║                                                                ║
# ║  4. Verificar que nunca se commitea a Git:                    ║
# ║     echo ".env" >> .gitignore                                 ║
# ║                                                                ║
# ║  5. Cargar variables en Python:                                ║
# ║     from dotenv import load_dotenv                            ║
# ║     load_dotenv()                                              ║
# ║     api_key = os.getenv("GEMINI_API_KEY")                     ║
# ║                                                                ║
# ╚═══════════════════════════════════════════════════════════════╝

GEMINI_API_KEY_FALLBACK_2=tu_gemini_api_key_fallback_2_aqui
# ===== AZURE OPENAI =====
# AZURE_OPENAI_API_KEY_1="tu_azure_openai_key_1_aqui"
# AZURE_OPENAI_API_KEY_2="tu_azure_openai_key_2_aqui"
# AZURE_OPENAI_ENDPOINT="https://khaipixy-resource.openai.azure.com/"
# AZURE_OPENAI_DEPLOYMENT="gpt-4.1-mini"
