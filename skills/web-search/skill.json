  "output_schema": {
    "type": "object",
    "properties": {"provider": {"type": "string"}, "results": {"type": "array"}},
    "required": ["provider", "results"],
    "additionalProperties": false
  },
  "runtime": "SAFE",
  "dependencies": [],
